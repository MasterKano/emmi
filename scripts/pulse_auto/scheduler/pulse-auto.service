[Unit]
Description=Checked numbers-only Market Pulse pilot (no email)
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=box
Environment=TZ=Europe/Zurich
EnvironmentFile=-/home/box/.config/brief.env
WorkingDirectory=/workspace/brief
ExecStart=/workspace/brief/auto/pulse_auto.sh --publish
TimeoutStartSec=45min
